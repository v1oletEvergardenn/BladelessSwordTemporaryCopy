--- !u!114 &8402145979667238661
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3314860176216050022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c594fa09de6cb4d4bb0264bd4f3cf0c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialManager: {fileID: 7058351719599369686}
  isJumpOut: 1
  title: Boss Battle
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 91c0335657ab74a45b7a1ef2d177cb7f, type: 3}
    context: "Boss Battle 1 \u2013 Prescient Eyes\r\nWhen facing powerful Boss, the
      hilt will predict the timing of Boss attacks, signaling Qin through a red outline
      flash. This allows Qin to Counter attack these attacks which with red outline.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 2edfbe39547c62b42a01edadc70b5bc1, type: 3}
    context: "Boss Battle 2 \u2013 Strength\r\nSome bosses will have a gray bar below
      their health bar, indicating their Strength value. "
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 8d59e7737bed9464ea0d0ddb519d8c5b, type: 3}
    context: "Boss Battle 2 \u2013 Strength\r\nQin can reduce this Strength by Counter
      attack Boss's attacks. Once the boss\u2019s Strength reaches zero, the Boss
      will be stunned for a short period.\r\n"
