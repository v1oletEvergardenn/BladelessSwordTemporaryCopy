  isJumpOut: 0
  title: Basic Movement
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 86467b213bde1af4c8ebee8b648a107e, type: 3}
    context: "Basic Movement 1 \u2013 Moving\r\nUse L stick let Qin move.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 09cc1fed3016a0a4f9c2d8bb9fdd54de, type: 3}
    context: "Basic Movement 2 \u2013 Jump\r\nPress A makes Qin jump into the air.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 9d66e31bedac47d4ebdc33d43ac589a6, type: 3}
    context: "Basic Movement 3 \u2013 Dash\r\nPress X makes Qin do a short-distance
      dash, which can be used to dodge attacks. Dashing consumes Qi.\r\n"
