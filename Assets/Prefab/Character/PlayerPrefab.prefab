  isJumpOut: 0
  title: Status
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 90a30d2db757e62478a9624eed366ac4, type: 3}
    context: "Status 1 \u2013 HP Bar\r\nThe HP bar represents Qin\u2019s health.
      \nWhen the health reaches 0, Qin will die.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 90a30d2db757e62478a9624eed366ac4, type: 3}
    context: "Status 2 \u2013 Qi Bar\r\nThe Qi bar represents Qin\u2019s Qi, a special
      energy. \nSome skills and actions consume Qi. \nQi automatically regenerates
      over time.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 5914a09afc161cf41bc217752b5e4f09, type: 3}
    context: "Status 3 \u2013 Heart Sword Bar\r\nThe sword-like bar represents the
      amount of Heart Sword energy available.\r\n"
