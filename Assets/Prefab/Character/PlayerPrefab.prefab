  m_GameObject: {fileID: 7723559804632620654}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c594fa09de6cb4d4bb0264bd4f3cf0c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialManager: {fileID: 5786865479423652604}
  isJumpOut: 0
  title: Heart Sword Attack
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: bbb4700518bb368409b5048fb5cf2725, type: 3}
    context: "Heart Sword Attack 1 \u2013 Activate and Deactivate\r\nWhen Qin has
      Heart Sword energy, pressing RB to activate the Heart Sword energy, pressing
      LB can deactivate Heart Sword energy.\n\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: bbb4700518bb368409b5048fb5cf2725, type: 3}
    context: "Heart Sword Attack 1 \u2013 Activate and Deactivate\r\nQin can activate
      multiple Heart Sword energies to transform several upcoming Counter attacks
      into Heart Sword attacks"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 23c210008b44c4b44be151d8d87023c7, type: 3}
    context: "Heart Sword Attack 2 \u2013 Heart Sword Attack\r\nIf Qin has activated
      a Heart Sword energy, then Qin\u2019s next Counter attack deals direct damage
      to enemies. \n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 23c210008b44c4b44be151d8d87023c7, type: 3}
    context: "Heart Sword Attack 2 \u2013 Heart Sword Attack\r\nThe Heart Sword attack
      has the same effect as a counter-attack, but it does not consume Qi.\r\r\n"
