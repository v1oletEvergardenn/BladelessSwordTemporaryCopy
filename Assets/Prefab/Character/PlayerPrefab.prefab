--- !u!114 &3485215862779498606
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1904366876265470725}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c594fa09de6cb4d4bb0264bd4f3cf0c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialManager: {fileID: 5786865479423652604}
  isJumpOut: 0
  title: Sword Teleport
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: ff998d3e1fa010a458849247d09df526, type: 3}
    context: "Sword Teleport 1 \u2013 Teleport\r\r\nQin can press Y to throw the
      sword, and press Y again to teleport to the position of the sword. \r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: ff998d3e1fa010a458849247d09df526, type: 3}
    context: "Sword Teleport 1 \u2013 Teleport\r\nQin can retrieve the flying sword
      using counter-attack, Sword Jump, or defense."
  - sentenceIndex: 
    image: {fileID: 0}
    context: "Sword Teleport 2 \u2013 Walls\r\nThere are two types of special walls:
      soft walls and hard walls.\r\n\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 80432cb419ebbbd4eb4cb6f4a7568be0, type: 3}
    context: "Sword Teleport 2 \u2013 Walls\r\r\nWhen the sword touches a soft wall
      while flying, it will embed itself in the wall and stay there.\r\n\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: c008667111a9f6a46b234df237b161b2, type: 3}
    context: "Sword Teleport 2 \u2013 Walls\r\r\nWhen the sword touches a hard wall,
      it will bounce off. When Qin can choose the direction of the bounce of the
      first hard wall the flying sword touch.\r\n"
