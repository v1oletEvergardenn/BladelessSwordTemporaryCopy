  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7472733236945534981}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c594fa09de6cb4d4bb0264bd4f3cf0c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialManager: {fileID: 5786865479423652604}
  isJumpOut: 0
  title: Sword Jump
  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: ab3bfc4aa21a9ca4a9d18b25aed992f2, type: 3}
    context: "Sword Jump 1 \u2013 Jump in the Air\r\nBy pressing A in the air, Qin
      can use Sword Jump. Sword Jump consumes Qi.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 01c816737691650499fd73dd393e39a3, type: 3}
    context: "Sword Jump 2 \u2013 Floating and Charging\nHolding down the A button
      during a Sword Jump will cause Qin to float slowly while charging energy. "
  - sentenceIndex: 
    image: {fileID: 21300000, guid: 01c816737691650499fd73dd393e39a3, type: 3}
    context: "Sword Jump 2 \u2013 Floating and Charging\nReleasing the A button will
      trigger a Charged Sword Jump. The jump\u2019s power varies based on how long
      the energy is charged. Floating consumes Qi continuously.\r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: a86e0554e4a0e134b9a5b807556b8397, type: 3}
    context: "Sword Jump 3 \u2013 Sword Jump Counter Attack\nAt the moment Qin performs
      a Sword Jump, Qin can counter-attack projectiles below. \r\n"
  - sentenceIndex: 
    image: {fileID: 21300000, guid: a86e0554e4a0e134b9a5b807556b8397, type: 3}
    context: "Sword Jump 3 \u2013 Sword Jump Counter Attack\nIf Qin successfully
      uses Sword Jump Counter Attack on a projectile, Qin can use Sword Jump again
      and recover a small amount of Qi.\r\n"
