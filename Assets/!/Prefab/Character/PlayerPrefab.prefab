  tutorialPage:
  - sentenceIndex: 
    image: {fileID: 21300000, guid: ee4ed62e9a267c94faaa310153f4436f, type: 3}
    context: "Defend\r\nPressing the LT button allows Qin to defend, blocking any
      attacks from the front. However, attacks from behind will still harm Qin. \nStaying
      in defense continuously consumes Qi.\r\n"
