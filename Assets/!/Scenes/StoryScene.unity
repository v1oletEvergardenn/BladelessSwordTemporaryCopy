    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: It is that thing./click/
    callback:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1394298617}
          m_TargetAssemblyTypeName: CameraRegister, Assembly-CSharp
          m_MethodName: SwitchThisCam
