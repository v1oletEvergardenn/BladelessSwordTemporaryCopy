  dialogs:
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: /close:1//size:80/Congratulations! ! !
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: "It\u2019s been a while since I\u2019ve taught, but it seems I\u2019m
      still good at it."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: I wish you the best of luck on your upcoming adventures.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: And I look forward to seeing you in the full version of the game.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: Farewell!
