  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: Look above.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: That seems to be the button to open the door.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 1
    sentence: "It\u2019s so high./wait:0.5/ \nEven if I jump, I can\u2019t reach
      it. ."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: Then just hit it.
    callback:
      m_PersistentCalls:
