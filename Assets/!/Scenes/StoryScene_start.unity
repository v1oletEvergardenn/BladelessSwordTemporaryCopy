  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 392c0312a193c3e43943423eae29d5cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  initialSize: 55
  initialSpeed: 0.015
  dialogs:
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: /close:1//size:80/Congratulations! ! !
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: "It\u2019s been a while since I\u2019ve taught, but it seems I\u2019m
      still good at it."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: I wish you the best of luck on your upcoming adventures.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: And I look forward to seeing you in the full version of the game.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 0
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: Farewell!
    callback:
      m_PersistentCalls:
        m_Calls: []
