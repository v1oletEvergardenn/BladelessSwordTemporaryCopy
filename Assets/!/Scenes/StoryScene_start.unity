--- !u!114 &644446593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 644446591}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 392c0312a193c3e43943423eae29d5cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  initialSize: 55
  initialSpeed: 0.015
  dialogs:
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 1
    sentence: 'This distance is a bit tough for me. '
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: "Hey,hey,/wait:0.5/\nhaven\u2019t I been teaching you how to use Qi
      in the past year?"
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: 'Chop-chop.

      We need to move faster.'
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 1
    sentence: "Eh?/wait:0.5/ \nYes sir!"
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 1
    sentence: (Qi.../wait:0.5/ that mysterious energy in the nature.)
    callback:
      m_PersistentCalls:
        m_Calls: []
