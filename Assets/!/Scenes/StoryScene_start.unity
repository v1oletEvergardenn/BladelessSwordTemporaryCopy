--- !u!114 &2043274021
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2043274019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 392c0312a193c3e43943423eae29d5cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  initialSize: 55
  initialSpeed: 0.015
  dialogs:
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: With this level of skill, you dare intrude on my sect?
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 4
    emotion: 
    isSkippable: 0
    sentence: /size:80/Wait!/wait:0.5/ /size:60/I just want to talk!
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: "Barging into someone\u2019s house without a word and saying you just
      want to talk? "
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 4
    emotion: 
    isSkippable: 0
    sentence: . . .
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: " You\u2019re here to get the Hundred Sect Championship entry rights,
      aren\u2019t you?"
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 4
    emotion: 
    isSkippable: 0
    sentence: 'Why you know that?/wait:0.5/

      Anyway, please listen to me...'
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: Do you really think I would hand over the chance to make my wish come
      true?
    callback:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 0
    emotion: 
    isSkippable: 0
    sentence: /close:3/See? Just like I said.s
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 0
    sentence: . . .
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 0
    emotion: 
    isSkippable: 0
    sentence: Is that her? The one carrying the bladeless sword.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 0
    emotion: 
    isSkippable: 0
    sentence: You still alive?
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 0
    sentence: "I wish I would died so I wouldn\u2019t have to hear you nag anymore."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: "You\u2019re so weak."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 0
    sentence: You do not need to tell me that.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: But fortunately,He doesn't seem to wanna kill you.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: "And the Qi in this mountain is strong. \nThere should be something
      here to enhance your abilities."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 0
    sentence: "With my current power, I can\u2019t stand up to Qian Xiao. \nI should
      train myself first."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 0
    sentence: "I really want to just charge back in and punch that guy/wait:0.5/\n\u2014no,
      slash that guy would be better."
    callback:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: MenuManager, Assembly-CSharp
          m_MethodName: EndCanvas
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
