--- !u!114 &1790466921
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1790466919}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 392c0312a193c3e43943423eae29d5cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  initialSize: 55
  initialSpeed: 0.015
  dialogs:
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: ' /close:2//size:50/E/wait:0.5//size:60/-excuse me! '
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: "(It\u2019s been so long since I\u2019ve talked to someone.)"
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: (and he is.../wait:0.5/ a handsome man.)
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: Still just a little girl..
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: /size:40/You have come, and sooner than I expected.
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 2
    emotion: 
    isSkippable: 1
    sentence: Um.../wait:0.5/ I have something I would like to....
    callback:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 74302840}
          m_TargetAssemblyTypeName: InternalGameManager, Assembly-CSharp
          m_MethodName: Story_2_0_Event
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 0
    emotion: 
    isSkippable: 1
    sentence: /close:2//size:80/Ah!
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 4
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: "Nice reflexes, but it won\u2019t be so easy from now."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 4
    emotion: 
    isSkippable: 1
    sentence: " Please\u2026"
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 3
    secondCharacter: 1
    emotion: 
    isSkippable: 1
    sentence: "Drop that merciful heart of yours; this guy\u2019s serious."
    callback:
      m_PersistentCalls:
        m_Calls: []
  - sentenceIndex: 
    firstCharacter: 1
    secondCharacter: 3
    emotion: 
    isSkippable: 1
    sentence: 'At least I have to calm him down! '
    callback:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: QianXiaoAI, Assembly-CSharp
          m_MethodName: SetCombat
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: CameraRegister, Assembly-CSharp
          m_MethodName: SwitchToNormalCam
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
